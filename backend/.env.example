# Django Settings
SECRET_KEY=smashcity-insecure-development-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Razorpay Configuration
# For production or test with real keys, replace these with your actual key id and secret from Razorpay Dashboard
RAZORPAY_KEY_ID=rzp_test_SmashCityDevKey
RAZORPAY_KEY_SECRET=SmashCitySecretTestModeOnly
RAZORPAY_WEBHOOK_SECRET=SmashCityWebhookSecretKey

# Test Gateway Mode (True enables mock payment completion if real Razorpay keys are not active)
RAZORPAY_TEST_MODE=True
